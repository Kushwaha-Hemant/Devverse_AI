# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# cloudflare / opennext build output
# .open-next is ~26MB of generated worker bundle and .wrangler-dryrun ~15MB.
# Both are regenerated by `npm run cf:build`; neither belongs in git.
/.open-next/
/.wrangler/
/.wrangler-dryrun/

# résumé PDF — kept out of git so the phone number and personal email in it
# stay out of public history. It is already uploaded to the deployed worker,
# so the live download buttons work; a fresh clone needs the file dropped
# back into public/resume/ to serve it locally.
/public/resume/

# misc
.DS_Store
*.pem

# agent tooling — local design/QA skills, not part of the portfolio itself.
# Kept on disk, kept out of the published repo.
/.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. README's quick start says `cp .env.example .env.local`,
# which fails on a fresh clone if this is ignored — and the file is the only
# record of which variables the app reads. It holds names only, never values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
