# ---------------------------------------------------------------------------
# DevVerse AI — environment
# Copy to `.env.local` and fill in. Every variable is OPTIONAL: the site runs
# fully without any of them, with graceful fallbacks.
# ---------------------------------------------------------------------------

# --- AI assistant (/api/ai) ---
# Without a key the assistant answers from a grounded keyword fallback built
# from your own content, so the feature still works on a fresh clone.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- GitHub stats (/api/github) ---
# Works unauthenticated (60 requests/hour per IP, and responses are cached for
# an hour). A token raises the limit to 5000/hour — only needed under real load.
GITHUB_TOKEN=

# --- Contact form (/api/contact) ---
# Without a key the form tells the sender email isn't configured and points
# them at your address, rather than silently dropping the message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=portfolio@resend.dev
